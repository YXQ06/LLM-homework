# AnythingLLM 连接配置（本地密钥文件，已被 .gitignore 忽略）
# 复制本文件为 .env 后填写真实值；不要把真实密钥提交到版本库。

# AnythingLLM 服务地址（不带 /api/v1）
ANYTHINGLLM_BASE_URL=http://localhost:3001

# 在 AnythingLLM「Settings → API Keys」中生成的密钥
ANYTHINGLLM_API_KEY=

# 默认工作区 slug；留空时前端会列出所有工作区供选择
ANYTHINGLLM_WORKSPACE=default

# 本地网页服务监听地址与端口
XAGENT_WEB_HOST=127.0.0.1
XAGENT_WEB_PORT=8080
