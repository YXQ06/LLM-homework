/* xAgent TUI 样式：所有颜色均取自当前主题变量，深浅色自动联动。 */

Screen {
    background: $background;
    color: $text;
}

/* ---------- 顶部标题栏 ---------- */

TitleBar {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#app-title {
    width: 1fr;
    height: 1;
    content-align: left middle;
    text-style: bold;
}

.header-button {
    width: auto;
    min-width: 6;
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 0 0 1;
    background: $primary;
    color: $text;
}

.header-button:hover {
    background: $primary-lighten-2;
}

.header-button:focus {
    background: $primary-lighten-1;
    text-style: bold;
}

/* ---------- 上下文使用量状态条 ---------- */

#context-bar {
    height: 1;
    content-align: left middle;
    background: $boost;
    color: $text;
    padding: 0 1;
}

/* ---------- 上下文压缩预览浮动面板 ---------- */

CompactPreviewScreen {
    align: center middle;
    background: $background;
}

#compact-dialog {
    width: 92%;
    height: 88%;
    border: thick $accent;
    background: $panel;
    padding: 1 2;
}

#compact-title {
    height: 1;
    color: $accent;
    text-style: bold;
}

#compact-hint {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

#compact-columns {
    width: 100%;
    height: 1fr;
}

.compact-column {
    width: 1fr;
    height: 1fr;
    border: tall $primary;
    margin: 0 1;
    background: $surface;
}

.compact-heading {
    height: 1;
    padding: 0 1;
    background: $primary;
    color: $text;
    text-style: bold;
}

.compact-scroll {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

.compact-body {
    width: 100%;
    color: $text;
}

#compact-close {
    width: 100%;
    margin-top: 1;
}

/* ---------- 主体左右分栏 ---------- */

#body {
    height: 1fr;
    layout: horizontal;
}

#main {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#log-container {
    height: 1fr;
    border: tall $primary;
    margin: 1 1 0 1;
    padding: 1 2;
    background: $panel;
}

#chat-log {
    background: $panel;
    color: $text;
}

/* ---------- 斜杠命令补全引导面板 ---------- */

#command-palette {
    display: none;
    height: auto;
    max-height: 12;
    margin: 0 1;
    padding: 0 1;
    border: tall $accent;
    background: $surface;
    color: $text;
    scrollbar-size-vertical: 1;
}

#command-palette.visible {
    display: block;
}

/* ---------- 历史会话选择面板 ---------- */

SessionPickerScreen {
    align: center middle;
    background: $background;
}

#session-dialog {
    width: 76%;
    height: 72%;
    border: thick $accent;
    background: $panel;
    padding: 1 2;
}

#session-title {
    height: 1;
    color: $accent;
    text-style: bold;
}

#session-hint {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

#session-list {
    height: 1fr;
    border: tall $primary;
    background: $surface;
}

#session-cancel {
    width: 100%;
    margin-top: 1;
}

/* ---------- 首次运行配置提示面板 ---------- */

ConfigCreatedScreen {
    align: center middle;
    background: $background;
}

#config-dialog {
    width: 72%;
    height: auto;
    border: thick $warning;
    background: $panel;
    padding: 1 2;
}

#config-title {
    height: 1;
    color: $warning;
    text-style: bold;
}

#config-message {
    height: auto;
    margin-top: 1;
}

#config-path {
    height: auto;
    margin: 1 0;
    color: $text-muted;
}

#config-exit {
    width: 100%;
    margin-top: 1;
}

/* ---------- 底部输入区 ---------- */

#input-container {
    height: auto;
    min-height: 3;
    layout: horizontal;
    align-vertical: middle;
    border: tall $accent;
    margin: 0 1 1 1;
    padding: 0 1;
    background: $boost;
}

#waiting-spinner {
    width: 2;
    height: 1;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

#prompt-label {
    width: 3;
    height: 1;
    content-align: center middle;
    color: $accent;
}

#input-box {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
    border: none;
    padding: 0;
    background: $boost;
    color: $text;
}

#input-box:focus {
    border: none;
}

/* ---------- 右侧工具信息侧边栏 ---------- */

ToolSidebar {
    width: 40%;
    min-width: 34;
    max-width: 58;
    height: 1fr;
    background: $surface;
    border-left: solid $primary;
    padding: 1 1;
    scrollbar-size-vertical: 1;
}

ToolSidebar.collapsed {
    width: 6;
    min-width: 6;
    max-width: 6;
    padding: 1 0;
}

#sidebar-content {
    width: 100%;
    height: auto;
    color: $text;
}

/* ---------- 底部状态栏 ---------- */

StatusBar {
    height: 1;
    content-align: left middle;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

Footer {
    background: $surface;
    color: $text-muted;
}
