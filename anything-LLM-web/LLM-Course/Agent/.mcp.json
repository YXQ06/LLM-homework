{
  "mcpServers": {
    "Bazi": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "bazi-mcp"],
      "timeout": 120,
      "connect_timeout": 120
    },
    "Bazi-MCP": {
      "type": "streamable_http",
      "url": "http://127.0.0.1:8092/mcp",
      "timeout": 120,
      "connect_timeout": 60,
      "description": "本地 Streamable HTTP Bazi MCP（8092），由 autoStart 自动拉起；与本地 Bazi 提供相同工具。"
    },
    "PetHospitalMCP": {
      "type": "streamable_http",
      "url": "http://127.0.0.1:8090/mcp",
      "timeout": 60,
      "connect_timeout": 10
    },
    "AnythingLLMMCP": {
      "type": "streamable_http",
      "url": "http://127.0.0.1:8091/mcp",
      "timeout": 60,
      "connect_timeout": 10
    },
    "AgronomyMCP": {
      "type": "stdio",
      "command": "python",
      "args": ["mcp_servers/agronomy_mcp_server.py"],
      "cwd": "xAgent",
      "timeout": 120,
      "connect_timeout": 30,
      "enabled": false,
      "description": "耕云农学田间试验 MCP Server（stdio，默认关闭）。需要时把 enabled 改为 true。"
    }
  },
  "autoStart": {
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "xAgent/start_mcp_servers.ps1"
    ],
    "cwd": ".",
    "timeout": 180
  }
}
